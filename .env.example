# Solana Devnet Configuration for WindTunnel
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_KEYPAIR_PATH=C:/Users/PC/.config/solana/devnet-windtunnel.json

# Deployed DBC Pool & Config on Devnet (populated after running devnet-deploy.ts)
DEPLOYED_CONFIG_PUBKEY=
DEPLOYED_POOL_PUBKEY=
DEPLOYED_BASE_MINT=
DEPLOYED_QUOTE_MINT=So11111111111111111111111111111111111111112
